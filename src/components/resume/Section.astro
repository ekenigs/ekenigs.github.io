---
interface Props {
	id: string;
	variant?: 'default' | 'accent';
	class?: string;
}

const { id, variant = 'default', class: className = '' } = Astro.props;
---

<section
	id={id}
	class:list={['section', variant === 'accent' && 'section--accent', className]}
	data-animate-section
>
	<div class="section__inner" data-cursor-trail-content>
		<slot />
	</div>
</section>
