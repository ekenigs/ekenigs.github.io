---
import Section from "./Section.astro";
import SectionHeading from "./SectionHeading.astro";

type PortfolioLayout = "portrait" | "landscape";

const portfolioItems: {
	title: string;
	description: string;
	layout: PortfolioLayout;
	images: { src: string; alt: string }[];
}[] = [
	{
		title: "Tanssi dApp",
		layout: "portrait",
		description:
			"Led end-to-end delivery of the Tanssi dApp—staking flows, chain management, and operator tooling in one Next.js/Mantine surface, integrated with Symbiotic for Ethereum-backed restaked security.",
		images: [1, 2, 3, 4, 5].map((n) => ({
			src: `/portfolio/tanssi/tanssi_${n}.webp`,
			alt: `Tanssi dApp — screenshot ${n}`,
		})),
	},
	{
		title: "Moonbeam dApp",
		layout: "landscape",
		description:
			"Built the Moonbeam dApp dashboard for token balances, staking rewards, and allocation breakdowns—real-time portfolio monitoring across Moonbeam's cross-chain connected-app stack.",
		images: [1, 2, 3, 4, 5].map((n) => ({
			src: `/portfolio/mbf/mbf_${n}.webp`,
			alt: `Moonbeam dApp — screenshot ${n}`,
		})),
	},
];
---

<Section id="portfolio">
	<div data-portfolio-root>
		<SectionHeading>Portfolio</SectionHeading>
		<ul class="space-y-8" data-animate-stagger>
			{
				portfolioItems.map((item) => (
					<li>
						<article
							data-portfolio-item
							class="card-surface"
							data-images={JSON.stringify(item.images)}
							data-slide-count={item.images.length}
							data-layout={item.layout}
						>
							<h3 class="text-lg font-semibold text-zinc-900 dark:text-zinc-50">{item.title}</h3>
							<p class="mt-3 text-sm leading-relaxed text-zinc-600 dark:text-zinc-300">
								{item.description}
							</p>
							<div class="mt-5">
								<div
									class:list={[
										"overflow-hidden rounded-lg",
										item.layout === "landscape" && "bg-zinc-200/30 dark:bg-zinc-950/40",
									]}
								>
									<div
										data-carousel-track
										class="flex snap-x snap-mandatory overflow-x-auto scroll-smooth [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
									>
										{item.images.map((img, i) => (
											<button
												type="button"
												data-open-lightbox
												data-carousel-slide
												data-image-index={i}
												class:list={[
													"group relative border-0 p-0",
													item.layout === "portrait"
														? "portfolio-slide--portrait"
														: "portfolio-slide--landscape flex overflow-hidden",
												]}
											>
												{item.layout === "portrait" ? (
													<span class="portfolio-slide__frame--portrait relative">
														<img
															src={img.src}
															alt={img.alt}
															loading="lazy"
															decoding="async"
															class="transition group-hover:opacity-95"
														/>
														<span class="pointer-events-none absolute bottom-2 right-2 rounded-md bg-zinc-950/70 px-2 py-1 text-xs text-zinc-100 opacity-0 transition group-hover:opacity-100 group-focus-visible:opacity-100 sm:opacity-0">
															Expand
														</span>
													</span>
												) : (
													<>
														<img
															src={img.src}
															alt={img.alt}
															loading="lazy"
															decoding="async"
															class="transition group-hover:opacity-95"
														/>
														<span class="pointer-events-none absolute bottom-2 right-2 rounded-md bg-zinc-950/70 px-2 py-1 text-xs text-zinc-100 opacity-0 transition group-hover:opacity-100 group-focus-visible:opacity-100 sm:opacity-0">
															Expand
														</span>
													</>
												)}
											</button>
										))}
									</div>
								</div>
								<div class="mt-3 flex items-center justify-between gap-3">
									<button
										type="button"
										data-carousel-prev
										class="icon-btn h-11 w-11 shrink-0"
										aria-label="Previous screenshot"
									>
										<svg
											class="pointer-events-none h-5 w-5 shrink-0"
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="2.5"
											stroke-linecap="round"
											stroke-linejoin="round"
											aria-hidden="true"
										>
											<path d="M15 19l-7-7 7-7" />
										</svg>
									</button>
									<div class="min-w-0 flex-1 text-center">
										<p
											data-carousel-status
											class="text-sm font-medium tabular-nums text-zinc-700 dark:text-zinc-300"
											aria-live="polite"
										>
											1 / {item.images.length}
										</p>
										<p class="text-muted mt-0.5 text-xs">Swipe or use arrows · tap to enlarge</p>
									</div>
									<button
										type="button"
										data-carousel-next
										class="icon-btn h-11 w-11 shrink-0"
										aria-label="Next screenshot"
									>
										<svg
											class="pointer-events-none h-5 w-5 shrink-0"
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="2.5"
											stroke-linecap="round"
											stroke-linejoin="round"
											aria-hidden="true"
										>
											<path d="M9 5l7 7-7 7" />
										</svg>
									</button>
								</div>
							</div>
						</article>
					</li>
				))
			}
		</ul>

		<div
			data-portfolio-modal
			class="portfolio-modal fixed inset-0 z-[100] hidden"
			role="dialog"
			aria-modal="true"
			aria-label="Image preview"
			aria-hidden="true"
		>
			<div
				data-modal-backdrop
				class="absolute inset-0 bg-zinc-950/90 backdrop-blur-[2px]"
				aria-hidden="true"
			/>
			<button
				type="button"
				data-modal-close
				class="icon-btn fixed top-[max(1rem,env(safe-area-inset-top))] right-[max(1rem,env(safe-area-inset-right))] z-[60] h-11 w-11 text-lg leading-none"
				aria-label="Close"
			>
				<span aria-hidden="true">×</span>
			</button>
			<div class="portfolio-modal__stage">
				<button
					type="button"
					data-modal-prev
					class="icon-btn fixed top-1/2 left-[max(0.75rem,env(safe-area-inset-left))] z-[60] h-12 w-12 -translate-y-1/2 sm:h-14 sm:w-14"
					aria-label="Previous image"
				>
					<svg
						class="pointer-events-none h-7 w-7 shrink-0 sm:h-8 sm:w-8"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2.5"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<path d="M15 19l-7-7 7-7" />
					</svg>
				</button>
				<div
					data-modal-viewport
					class="portfolio-modal__viewport portfolio-modal__viewport--landscape"
				>
					<img data-modal-img alt="" class="portfolio-modal__img--landscape" />
				</div>
				<button
					type="button"
					data-modal-next
					class="icon-btn fixed top-1/2 right-[max(0.75rem,env(safe-area-inset-right))] z-[60] h-12 w-12 -translate-y-1/2 sm:h-14 sm:w-14"
					aria-label="Next image"
				>
					<svg
						class="pointer-events-none h-7 w-7 shrink-0 sm:h-8 sm:w-8"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2.5"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<path d="M9 5l7 7-7 7" />
					</svg>
				</button>
			</div>
		</div>
	</div>
</Section>

<script>
	import "../../scripts/portfolio-section-client.ts";
</script>
