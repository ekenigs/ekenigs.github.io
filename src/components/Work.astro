---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import type { Tone } from "../data/resume";
import SectionHeading from "./SectionHeading.astro";

interface Project {
	id: string;
	title: string;
	label: string;
	description: string;
	tone: Tone;
	link?: { href: string; label: string };
	/** Folder under `src/assets/portfolio` holding the screenshots. */
	shots?: string;
}

const projects: Project[] = [
	{
		id: "sudory",
		title: "Sudory",
		label: "platform · compliance",
		description:
			"Daily security checks of a company's SaaS and cloud tools, turned into compliance evidence for ISO 27001, NIS2, and DORA.",
		tone: 1,
		link: { href: "https://sudory.com", label: "sudory.com" },
	},
	{
		id: "tanssi",
		title: "Tanssi dApp",
		label: "web app · staking",
		description:
			"Led end-to-end delivery of the Tanssi dApp: staking flows, chain management, and operator tooling in one Next.js and Mantine surface.",
		tone: 2,
		shots: "tanssi",
	},
	{
		id: "moonbeam",
		title: "Moonbeam dApp",
		label: "web app · dashboard",
		description:
			"Built the Moonbeam dApp dashboard for token balances, staking rewards, and allocation breakdowns across Moonbeam's connected chains.",
		tone: 3,
		shots: "mbf",
	},
];

const files = import.meta.glob<{ default: ImageMetadata }>(
	"../assets/portfolio/*/*.webp",
	{ eager: true },
);

async function screenshots(folder: string) {
	const sources = Object.entries(files)
		.filter(([path]) => path.includes(`/portfolio/${folder}/`))
		.sort(([a], [b]) => a.localeCompare(b))
		.map(([, mod]) => mod.default);
	return Promise.all(
		sources.map(async (src) => ({
			thumb: await getImage({ src, width: 720, widths: [320, 560, 720], format: "webp" }),
			full: await getImage({ src, width: 1800, format: "webp" }),
			/** Full-page captures scroll vertically instead of being fitted to the dialog. */
			tall: src.height > src.width * 1.2,
		})),
	);
}

const items = await Promise.all(
	projects.map(async (project) => ({
		...project,
		images: project.shots ? await screenshots(project.shots) : [],
	})),
);
---

<section id="work" class="work">
	<SectionHeading index="02">Selected work</SectionHeading>
	<div class="work__grid">
		{
			items.map((project) => {
				const cover = project.images[0];
				return (
					<article class="card work-card">
						<div
							class:list={["work-card__cover", `solid-${project.tone}`, cover && "has-shot"]}
							data-gallery-open={cover ? project.id : undefined}
						>
							<div class="mono-label">{project.label}</div>
							{cover ? (
								<img
									src={cover.thumb.src}
									srcset={cover.thumb.srcSet.attribute}
									sizes="(max-width: 640px) calc(100vw - 80px), 300px"
									width={cover.thumb.attributes.width}
									height={cover.thumb.attributes.height}
									alt=""
									loading="lazy"
									decoding="async"
								/>
							) : (
								<svg aria-hidden="true" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5.5c0 4.3-2.9 7.9-7 9.5-4.1-1.6-7-5.2-7-9.5V6l7-3z"></path><path d="M9 12l2 2 4-4"></path></svg>
							)}
						</div>
						<div class="work-card__body">
							<h3>{project.title}</h3>
							<p>{project.description}</p>
							<div class="work-card__links">
								{project.link && (
									<a href={project.link.href} target="_blank" rel="noopener noreferrer">
										{project.link.label} ↗
									</a>
								)}
								{cover && (
									<button type="button" data-gallery-open={project.id}>
										Screenshots ({project.images.length}) ↗
									</button>
								)}
							</div>
						</div>
					</article>
				);
			})
		}
	</div>

	{
		items
			.filter((project) => project.images.length > 0)
			.map((project) => (
				<dialog
					class="gallery"
					data-gallery={project.id}
					aria-label={`${project.title} screenshots`}
				>
					<div class="gallery__bar">
						<span class="mono-label">
							{project.title} · <span data-gallery-count>1</span> / {project.images.length}
						</span>
						<div class="gallery__controls">
							<button type="button" data-gallery-prev aria-label="Previous screenshot">←</button>
							<button type="button" data-gallery-next aria-label="Next screenshot">→</button>
							<button type="button" data-gallery-close aria-label="Close screenshots">✕</button>
						</div>
					</div>
					<div class="gallery__track" data-gallery-track>
						{project.images.map((image, i) => (
							<div class:list={["gallery__slide", image.tall && "gallery__slide--tall"]}>
								<img
									src={image.full.src}
									width={image.full.attributes.width}
									height={image.full.attributes.height}
									alt={`${project.title}, screenshot ${i + 1}`}
									loading="lazy"
									decoding="async"
								/>
							</div>
						))}
					</div>
				</dialog>
			))
	}
</section>

<script>
	for (const dialog of document.querySelectorAll<HTMLDialogElement>("dialog[data-gallery]")) {
		const track = dialog.querySelector<HTMLElement>("[data-gallery-track]");
		const count = dialog.querySelector<HTMLElement>("[data-gallery-count]");
		if (!track) continue;

		const step = (direction: number) =>
			track.scrollBy({ left: direction * track.clientWidth, behavior: "smooth" });

		dialog.querySelector("[data-gallery-prev]")?.addEventListener("click", () => step(-1));
		dialog.querySelector("[data-gallery-next]")?.addEventListener("click", () => step(1));
		dialog.querySelector("[data-gallery-close]")?.addEventListener("click", () => dialog.close());
		dialog.addEventListener("click", (event) => {
			if (event.target === dialog) dialog.close();
		});
		dialog.addEventListener("keydown", (event) => {
			if (event.key === "ArrowLeft") step(-1);
			if (event.key === "ArrowRight") step(1);
		});
		track.addEventListener("scroll", () => {
			if (count) count.textContent = String(Math.round(track.scrollLeft / track.clientWidth) + 1);
		});

		for (const opener of document.querySelectorAll(`[data-gallery-open="${dialog.dataset.gallery}"]`)) {
			opener.addEventListener("click", () => {
				dialog.showModal();
				track.scrollTo({ left: 0 });
			});
		}
	}
</script>
