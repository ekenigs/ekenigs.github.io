---
import Experience from "../components/Experience.astro";
import Hero from "../components/Hero.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Skills from "../components/Skills.astro";
import Work from "../components/Work.astro";
import { basics, summary } from "../data/resume";
import MainLayout from "../layouts/main.astro";

const pageTitle = `${basics.name} — ${basics.headline}`;
const metaDescription = summary.slice(0, 160);

const ogImageUrl = Astro.site ? new URL("/profile_picture.webp", Astro.site).href : undefined;

const jsonLd: Record<string, unknown> = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: basics.name,
	url: Astro.site ? new URL("/", Astro.site).href : undefined,
	jobTitle: basics.headline,
	...(ogImageUrl ? { image: ogImageUrl } : {}),
	email: basics.email,
	sameAs: [basics.linkedin, basics.github],
};
---

<MainLayout title={pageTitle} description={metaDescription} ogImageUrl={ogImageUrl} jsonLd={jsonLd}>
	<div class="page">
		<SiteHeader />
		<main class="page__main">
			<Hero />
			<Experience />
			<Work />
			<Skills />
		</main>
		<SiteFooter />
	</div>
</MainLayout>
